GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GROQ_API_KEY=
DEMO_MODE=false
NEXT_PUBLIC_USE_MOCK=true

# Optional: writable dir for runtime cache + audit (defaults to the project root; /tmp/awaaz on Vercel)
# AWAAZ_WRITE_DIR=

# Optional: WhatsApp intake via Twilio (see docs/FEATURES.md §12)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# WHATSAPP_WEBHOOK_URL=https://<your-deploy>/api/whatsapp
# WHATSAPP_ALLOW_UNSIGNED=false   # true only for local curl testing without Twilio
